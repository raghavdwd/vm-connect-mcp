{
  "bin": {
    "vm-connect": "./src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "commander": "^14.0.0",
    "ssh2": "^1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/ssh2": "^1.15.6",
    "typescript": "^5.6.0"
  },
  "name": "vm-connect-mcp",
  "private": true,
  "scripts": {
    "build": "bun build ./src/cli.ts --target bun --minify --outdir ./dist",
    "build:binary": "bun build ./src/cli.ts --compile --outfile ./dist/vm-connect-bin",
    "check": "tsc --noEmit",
    "dev": "bun run ./src/cli.ts --help",
    "mcp": "bun run ./src/mcp.ts",
    "test": "bun test"
  },
  "type": "module",
  "version": "0.1.0"
}
