{
  "name": "vm-connect-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vm-connect": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --target bun --minify --external @opentui/core --outdir ./dist",
    "build:binary": "bash ../../scripts/build-binary.sh",
    "check": "tsc --noEmit",
    "dev": "bun run ./src/cli.ts --help",
    "mcp": "bun run ./src/mcp.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@opentui/core": "^0.5.11",
    "commander": "^14.0.0",
    "ssh2": "^1.17.0",
    "zod": "^3.23.8"
  },
  "trustedDependencies": [
    "cpu-features"
  ],
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/ssh2": "^1.15.6",
    "typescript": "^5.6.0"
  }
}
